# The values the method needs, and nothing else. Copy to .env and fill it in.
#
# All scripts read this file. The writer also reads it. The environment wins over the
# file. A shell that has the variables set does not need the file.
#
# Never commit .env: it holds two passwords.

# --- the wiki --------------------------------------------------------------

# The api.php of the wiki. The write, and every read-back of a test, use it.
MEDIAWIKI_API_URL=https://wikibase.example/w/api.php

# The account that writes. It needs the page-edit right, and the API's clientlogin
# flow: a normal account password, or a bot password with the account it belongs to.
WIKIBASE_USERNAME=admin
WIKIBASE_PASSWORD=

# --- the database ----------------------------------------------------------

# The MariaDB/MySQL server that holds the wiki's tables. The capture reads the binlog
# over the wire. The account needs REPLICATION SLAVE and REPLICATION CLIENT in addition
# to SELECT and INSERT. Use a dedicated account with these four grants, not root.
# check-env.sh names each missing grant and gives the GRANT statement.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=my_wiki

# Optional. When DB_HOST is set, the scripts use TCP and rewrite localhost to
# 127.0.0.1. A client that receives localhost opens a Unix socket. Set
# DB_PROTOCOL=socket to ask for the socket.
# DB_PROTOCOL=

# Optional. The Python binlog reader leaves the library's MariaDB flag off, because
# on some servers it hides the row events. Set DB_IS_MARIADB=1 only if your server
# needs the MariaDB-specific events.
# DB_IS_MARIADB=0

# --- optional --------------------------------------------------------------

# TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR or CRITICAL. DEBUG shows every statement
# a write runs, and every value it computed for it.
LOG_LEVEL=INFO
