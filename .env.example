LOG_LEVEL=INFO

MEDIAWIKI_API_URL=https://wikibase.example/w/api.php
WIKIBASE_USERNAME=admin
WIKIBASE_PASSWORD=

DB_HOST=
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=my_wiki
